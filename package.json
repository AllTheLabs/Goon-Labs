{
  "name": "goon-labs",
  "productName": "Goon Labs",
  "version": "2.24.1",
  "description": "Organize, tag, view and export your photos and videos",
  "main": "./out/main/index.js",
  "author": "Goon Labs",
  "license": "ISC",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/AllTheLabs/Goon-Labs.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.goonlabs.app",
    "productName": "Goon Labs",
    "copyright": "Copyright © Goon Labs",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Goon Labs",
      "artifactName": "Goon-Labs-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "AllTheLabs",
      "repo": "Goon-Labs"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0",
    "onnxruntime-web": "^1.31.1"
  }
}

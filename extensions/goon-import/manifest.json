{
  "manifest_version": 2,
  "name": "Goon Labs Save",
  "description": "Save the media on this page into Goon Labs.",
  "version": "1.0.0",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "browser_action": {
    "default_title": "Save to Goon Labs",
    "default_icon": "icon.png"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "*://challenges.cloudflare.com/*",
        "*://*.challenges.cloudflare.com/*",
        "*://*.cloudflare.com/*"
      ],
      "js": ["overlay.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": ["icon.png"],
  "permissions": []
}
